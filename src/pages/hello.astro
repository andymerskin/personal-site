---
import HelloCallToAction from "../components/HelloCallToAction.astro";
import HelloFeaturedWork from "../components/HelloFeaturedWork.astro";
import HelloRecommendations from "../components/HelloRecommendations.astro";
import HelloSkills from "../components/HelloSkills.astro";
import HRule from "../components/HRule.astro";
import RolesGrid from "../components/RolesGrid.vue";
import RotatingHeadline from "../components/RotatingHeadline.vue";
import StructuredData from "../components/StructuredData.astro";
import { getSiteUrl, PAGE_METADATA } from "../config/pageMetadata";
import type { SkillId } from "../content/skills.gen";
import Layout from "../layouts/Layout.astro";

const featuredSkills: SkillId[] = [
  "product-discovery",
  "project-management",
  "napkin-sketching",
  "visual-design",
  "rapid-prototyping",
  "design-consulting",
  "react",
  "vue-3",
  "typescript",
  "tailwind",
  "msw",
  "e2e-testing",
  "github",
  "github-actions",
  "node-js",
  "bun",
  "rest-apis",
  "next-js-apis",
  "rpc",
  "vercel",
  "netlify",
  "sdlc",
];

const metadata = PAGE_METADATA.hello;
const siteUrl = getSiteUrl(Astro.site);
const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Andy Merskin",
  url: siteUrl,
  jobTitle: "Principal Software Engineer & Designer",
  image: new URL("/open-graph/hello.png", siteUrl).href,
  sameAs: [
    "https://github.com/andymerskin",
    "https://www.linkedin.com/in/andymerskin/",
    "https://dribbble.com/andymerskin",
    "https://codepen.io/andymerskin",
  ],
};
---

<Layout
  title="Hello 👋"
  description={metadata.description}
  image="/open-graph/hello.png"
  imageAlt="Andy Merskin — Personal Site"
>
  <StructuredData data={personSchema} />
  <RotatingHeadline client:load class="md:relative md:-top-1" />
  <p class="text-xl leading-relaxed dark:text-neutral-300">
    I'm a Principal Software Engineer (UI + UX, and budding Full Stack) <strong
      >leading engineering teams to success</strong
    >
    creating digital products, backed by thoughtful research, delightful user interactions,
    unified visual language, energizing motion, and well organized & optimized architecture.
  </p>

  <!-- Call to action -->
  <HelloCallToAction />

  <!-- Roles -->
  <h2 class="mt-32 -rotate-1 text-center text-4xl font-bold md:text-left">
    Let's work together to build your dream product!
  </h2>
  <p class="mt-6">
    Here's just a snippet of the roles I play, balancing rapid development with quality, and edge cases covered.
  </p>
  <div class="not-prose mt-12">
    <RolesGrid
      roles={[
        {
          icon: "user-check",
          title: "Product Leadership",
          description:
            "I can help you plan your product roadmap and features with strong usability and visual quality in mind, preventing users from making mistakes, and helping you build trust with them.",
        },
        {
          icon: "users",
          title: "Team Leadership",
          description:
            "I help teams stay aligned with the grand plan and keep the momentum going, removing obstacles, and finding better ways to work.",
        },
        {
          icon: "code",
          title: "Software Development",
          description:
            "I'm a front-end development specialist with a wide range of experience, from building brochure sites to complex web applications integrating data and interactivity.",
        },
        {
          icon: "palette",
          title: "Design Direction",
          description:
            "I can provide your team with design consultation and guidance to ensure everything is consistent with your brand and design system.",
        },
      ]}
    />
  </div>

  <!-- Recommendations -->
  <h2
    class="mt-16 -rotate-1 text-center text-4xl font-bold transition-transform duration-1200 hover:rotate-0 md:text-left"
  >
    <a href="/colleagues" class="decoration-amber-500 hover:underline"
      >Happy teams lead to happy users!</a
    >
  </h2>
  <p class="mt-6">
    Here's what a few colleagues had to say about working with me throughout my
    career:
  </p>
  <HelloRecommendations class="mt-6" />

  <!-- Featured Work -->
  <HelloFeaturedWork class="mt-16" />

  <!-- Skills & Technologies -->

  <h2 class="mt-16 text-4xl font-bold -rotate-1 text-center md:text-left">Skills & Technologies</h2>

  <p class="mt-6">
    As an individual contributor, I specialize in expert-level front-end
    development. I'd like to expand my skillset to explore full-stack and mobile
    development more. Here is my core skillset:
  </p>

  <HelloSkills class="mt-6" featuredSkills={featuredSkills} />
</Layout>
