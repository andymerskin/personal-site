---
import Layout from "../layouts/Layout.astro";
import RotatingHeadline from "../components/RotatingHeadline.astro";
import HelloRecommendations from "../components/HelloRecommendations.astro";
---

<Layout title="Principal Software Engineer & Designer">
  <RotatingHeadline class="md:relative md:-top-1" />
  <p class="text-xl leading-relaxed dark:text-neutral-300">
    I'm a Principal Software Engineer (UI + UX, and budding Full Stack) <strong
      >leading engineering teams to success</strong
    >
    creating digital products, backed by thoughtful research, delightful user interactions,
    unified visual language, energizing motion, and well organized & optimized architecture.
  </p>

  <!-- Rocker alert -->
  <div
    class="mt-16 animate-[rocking-alert_5s_ease-in-out_alternate_infinite] px-8"
  >
    <div
      class="alert-glow relative rounded-lg bg-cyan-100 p-8 dark:bg-cyan-700/40"
    >
      <p
        class="font-display flex flex-col items-center gap-4 text-center text-4xl leading-tight font-bold md:flex-row md:text-left"
      >
        <span
          >Need a fresh frontend for your B2B SaaS product <em>FAST?!</em><span
            class="ml-4">🔥</span
          ></span
        >
        <span class="font-sans whitespace-nowrap">Let's chat.</span>
      </p>
    </div>
  </div>

  <hr class="my-16 border-neutral-300 dark:border-neutral-700" />

  <!-- Recommendations -->
  <h2 class="-rotate-1 text-center text-4xl font-bold md:text-left hover:-rotate-2 transition-transform duration-300">
    <a href="/colleagues" class="hover:underline decoration-amber-500">Happy teams lead to happy users!</a>
  </h2>
  <HelloRecommendations class="mt-6" />
</Layout>

<style>
  @reference "tailwindcss";

  .alert-glow:before {
    @variant dark {
      --max-opacity: 0.33;
      @apply absolute top-1/2 left-1/2 z-[-1] h-0 w-1/2 -translate-x-1/2 -translate-y-1/2 scale-y-33 bg-transparent;
      content: "";
      box-shadow: 0 0 320px 128px var(--color-orange-400);
      animation: alert-glow 3s ease-in-out infinite;
    }
  }
</style>
