---
import HelloAlert from "../components/HelloAlert.astro";
import HelloFeaturedWork from "../components/HelloFeaturedWork.astro";
import HelloRecommendations from "../components/HelloRecommendations.astro";
import HelloSkillsByGroup from "../components/HelloSkillsByGroup.astro";
import HRule from "../components/HRule.astro";
import RotatingHeadline from "../components/RotatingHeadline.vue";
import SkillCardsGrid from "../components/SkillCardsGrid.astro";
import StructuredData from "../components/StructuredData.astro";
import { getSiteUrl, PAGE_METADATA } from "../config/pageMetadata";
import type { SkillId } from "../content/skills.gen";
import Layout from "../layouts/Layout.astro";

const featuredSkills: SkillId[] = [
  "product-discovery",
  "project-management",
  "napkin-sketching",
  "visual-design",
  "rapid-prototyping",
  "design-consulting",
  "react",
  "vue-3",
  "typescript",
  "tailwind",
  "msw",
  "e2e-testing",
  "github",
  "github-actions",
  "node-js",
  "bun",
  "rest-apis",
  "next-js-apis",
  "rpc",
  "vercel",
  "netlify",
  "sdlc",
];

const metadata = PAGE_METADATA.hello;
const siteUrl = getSiteUrl(Astro.site);
const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Andy Merskin",
  url: siteUrl,
  jobTitle: "Principal Software Engineer & Designer",
  image: new URL("/open-graph/hello.png", siteUrl).href,
  sameAs: [
    "https://github.com/andymerskin",
    "https://www.linkedin.com/in/andymerskin/",
    "https://dribbble.com/andymerskin",
    "https://codepen.io/andymerskin",
  ],
};
---

<Layout
  title="Hello 👋"
  description={metadata.description}
  image="/open-graph/hello.png"
  imageAlt="Andy Merskin — Personal Site"
>
  <StructuredData data={personSchema} />
  <RotatingHeadline client:load class="md:relative md:-top-1" />
  <p class="text-xl leading-relaxed dark:text-neutral-300">
    I'm a Principal Software Engineer (UI + UX, and budding Full Stack) <strong
      >leading engineering teams to success</strong
    >
    creating digital products, backed by thoughtful research, delightful user interactions,
    unified visual language, energizing motion, and well organized & optimized architecture.
  </p>

  <!-- Rocker alert -->
  <HelloAlert />

  <!-- Recommendations -->
  <h2
    class="mt-32 -rotate-1 text-center text-4xl font-bold transition-transform duration-1200 hover:rotate-0 md:text-left"
  >
    <a href="/colleagues" class="decoration-amber-500 hover:underline"
      >Happy teams lead to happy users!</a
    >
  </h2>

  <HelloRecommendations class="mt-6" />

  <!-- Skills & Technologies -->

  <h2 class="mt-16 text-4xl font-bold">Skills & Technologies</h2>

  <p class="mt-6">
    As an individual contributor, I specialize in expert-level front-end
    development. I'd like to expand my skillset to explore full-stack and
    mobile development more. Here is my core skillset:
  </p>

  <SkillCardsGrid class="mt-6" skills={featuredSkills} groupByType />

  <h3 class="mt-16 text-2xl font-bold">Everything else I'm familiar with:</h3>

  <HelloSkillsByGroup class="mt-6" exclude={featuredSkills} />

  <HRule class="my-12" />

  <HelloFeaturedWork />
</Layout>
