---
import Layout from "../layouts/Layout.astro";
import RotatingHeadline from "../components/RotatingHeadline.astro";
import TestimonialsList from "../components/TestimonialsList.astro";
---

<Layout title="Principal Software Engineer & Designer">
  <RotatingHeadline class="md:relative md:-top-1" />
  <p class="text-xl leading-relaxed dark:text-neutral-300">
    I'm a Principal Software Engineer (UI + UX, and budding Full Stack) <strong
      >leading engineering teams to success</strong
    >
    creating digital products, backed by thoughtful research, delightful user interactions,
    unified visual language, energizing motion, and well organized & optimized architecture.
  </p>

  <!-- Rocker alert -->
  <div
    class="animate-[rocking-alert_5s_ease-in-out_alternate_infinite] px-8 mt-16"
  >
    <div class="p-8 bg-cyan-100 dark:bg-cyan-700/40 rounded-lg relative alert-glow">
      <p
        class="flex flex-col items-center text-center md:flex-row md:text-left gap-4 font-display text-4xl leading-tight font-bold"
      >
        <span
          >Need a fresh frontend for your B2B SaaS product <em>FAST?!</em><span
            class="ml-4">🔥</span
          ></span
        >
        <span class="font-sans whitespace-nowrap">Let's chat.</span>
      </p>
    </div>
  </div>

  <hr class="my-16 border-neutral-300 dark:border-neutral-700" />

  <!-- Testimonials -->
  <h2 class="text-2xl font-bold -rotate-1">Happy teams lead to happy users!</h2>
  <TestimonialsList class="mt-8" />
</Layout>

<style>
  @reference "tailwindcss";

  .alert-glow:before {    
    @variant dark {
      --max-opacity: 0.33;
      @apply absolute w-1/2 h-0 left-1/2 top-1/2 z-[-1] -translate-x-1/2 -translate-y-1/2 scale-y-33 bg-transparent;
      content: "";
      box-shadow: 0 0 320px 128px var(--color-orange-400);
      animation: alert-glow 3s ease-in-out infinite;
    }
  }
</style>
