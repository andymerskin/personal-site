---
import { getImage } from "astro:assets";
import { getCollection } from "astro:content";
import StructuredData from "../../components/StructuredData.astro";
import WorkGrid from "../../components/WorkGrid.vue";
import WorkTabs from "../../components/WorkTabs.astro";
import { getSiteUrl, PAGE_METADATA } from "../../config/pageMetadata";
import Layout from "../../layouts/Layout.astro";

const workItems = (await getCollection("work")).filter(
  (entry) => entry.data.category === "fun",
);

const workCards = await Promise.all(
  workItems.map(async ({ id, data }) => {
    const optimizedLogo = await getImage({
      src: data.logo,
      widths: [200, 400, 600],
      sizes: "(max-width: 639px) 100vw, 50vw",
    });

    return {
      id,
      title: data.title,
      type: data.type,
      year: data.year,
      classes: data.classes ?? "",
      logoAttrs: {
        src: optimizedLogo.src,
        srcset: optimizedLogo.srcSet?.attribute,
        sizes: optimizedLogo.attributes.sizes,
        width: optimizedLogo.attributes.width,
        height: optimizedLogo.attributes.height,
      },
    };
  }),
);

const metadata = PAGE_METADATA["work/fun"];
const siteUrl = getSiteUrl(Astro.site);
const collectionSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: metadata.title,
  description: metadata.description,
  url: new URL("/work/fun", siteUrl).href,
};
---

<Layout
  title={metadata.title}
  description={metadata.description}
  image="/open-graph/work/fun.png"
>
  <StructuredData data={collectionSchema} />
  <div class="flex flex-wrap items-center justify-between gap-4">
    <h1 class="text-5xl font-bold tracking-tight">Work</h1>
    {/* <WorkTabs /> */}
  </div>

  <section class="mt-8">
    <WorkGrid entries={workCards} client:only="vue" />
  </section>
</Layout>
