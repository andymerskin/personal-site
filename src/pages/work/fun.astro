---
import { getCollection } from "astro:content";
import Tabs from "../../components/Tabs.astro";
import WorkGrid from "../../components/WorkGrid.vue";
import StructuredData from "../../components/StructuredData.astro";
import { getSiteUrl, PAGE_METADATA } from "../../config/pageMetadata";
import Layout from "../../layouts/Layout.astro";

const tabs = [
  { label: "Public", href: "/work/public" },
  { label: "Private", href: "/work/private" },
  { label: "Fun", href: "/work/fun" },
];

const workItems = (await getCollection("work")).filter(
  (entry) => entry.data.category === "fun",
);

const workCards = workItems.map(({ id, data }) => ({
  id,
  title: data.title,
  type: data.type,
  year: data.year,
  classes: data.classes ?? "",
  logoSrc: String(data.logo.src),
}));

const metadata = PAGE_METADATA["work/fun"];
const siteUrl = getSiteUrl(Astro.site);
const collectionSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: metadata.title,
  description: metadata.description,
  url: new URL("/work/fun", siteUrl).href,
};
---

<Layout
  title={metadata.title}
  description={metadata.description}
  image="/open-graph/work/fun.png"
>
  <StructuredData data={collectionSchema} />
  <div class="flex flex-wrap items-center justify-between gap-4">
    <h1 class="text-5xl font-bold tracking-tight">Work</h1>
    <Tabs tabs={tabs} disableTransitions />
  </div>

  <section class="mt-8">
    <WorkGrid entries={workCards} client:only="vue" />
  </section>
</Layout>
