---
import Layout from "../../layouts/Layout.astro";
import type { CollectionEntry } from "astro:content";
import { getCollection, render } from "astro:content";
import Button from "../../components/Button.astro";
import Prose from "../../components/Prose.astro";
import WorkSkills from "../../components/WorkSkills.astro";

export async function getStaticPaths() {
  const entries = await getCollection("work");
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props as { entry: CollectionEntry<"work"> };
const { Content } = await render(entry);
---

<Layout title={entry.data.title}>
  <header>
    <nav>
      <a
        class="underline-offset-4 opacity-70 hover:underline hover:opacity-100"
        href="/work">← Work</a
      >
    </nav>
    <div class="mt-4 text-5xl font-bold tracking-tight">
      {entry.data.headline}
    </div>
    <div class="mt-8 flex items-start justify-between">
      <div>
        <h1 class="text-3xl font-bold tracking-tight">{entry.data.title}</h1>
        <div class="mt-2 flex gap-2 text-sm">
          <span class="text-neutral-600 dark:text-neutral-400">
            {entry.data.type}
          </span>
          •
          <span class="text-neutral-600 dark:text-neutral-400">
            {entry.data.year}
          </span>
        </div>
      </div>

      <a href={entry.data.externalUrl}>
        <Button>
          Visit project
          <span aria-hidden="true">↗</span>
        </Button>
      </a>
    </div>
  </header>
  <section class="mt-8">
    <Prose>
      <Content
        components={{ Tooltip: TooltipWrapper, WorkSkills, RolesGrid }}
      />
    </Prose>
  </section>
</Layout>
