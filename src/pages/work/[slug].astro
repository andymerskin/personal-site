---
import Layout from "../../layouts/Layout.astro";
import type { CollectionEntry } from "astro:content";
import { getCollection, render } from "astro:content";
import Button from "../../components/Button.astro";

export async function getStaticPaths() {
  const entries = await getCollection("work");
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props as { entry: CollectionEntry<"work"> };
const { Content } = await render(entry);
---

<Layout title={entry.data.title}>
  <header>
    <h1 class="text-3xl font-bold tracking-tight">{entry.data.title}</h1>
    <div class="flex gap-2 mt-2 text-sm">
      <nav class="inline">
        <a
          class="opacity-70 hover:opacity-100 underline-offset-4 hover:underline"
          href="/work">Work</a
        >
      </nav>
      •
      <span class="text-neutral-600 dark:text-neutral-400">
        {entry.data.type}
      </span>
      •
      <span class="text-neutral-600 dark:text-neutral-400">
        {entry.data.year}
      </span>
    </div>
  </header>

  <section class="mt-8">
    <div
      class:list={[
        "work-card-logo",
        "w-full rounded-lg overflow-hidden",
        "bg-shade-primary/3 dark:bg-white",
        "inset-ring-1 inset-ring-shade-primary/5 dark:inset-ring-0",
        entry.data.classes,
      ]}
    >
      <div class="flex items-center justify-center p-10">
        <img
          src={entry.data.logo.src}
          alt=""
          class="max-h-40 w-auto object-contain"
          loading="lazy"
          decoding="async"
        />
      </div>
    </div>

    <div
      class="mt-8 text-sm leading-relaxed text-neutral-700 dark:text-neutral-300 [&_p]:mt-4 [&_a]:underline [&_a]:underline-offset-4"
    >
      <Content />
    </div>

    <div class="mt-8">
      <a href={entry.data.externalUrl}>
        <Button>
          Visit project
          <span aria-hidden="true">→</span>
        </Button>
      </a>
    </div>
  </section>
</Layout>
