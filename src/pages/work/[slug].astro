---
import type { CollectionEntry } from "astro:content";
import { getCollection, render } from "astro:content";
import Button from "../../components/Button.astro";
import HRule from "../../components/HRule.astro";
import Prose from "../../components/Prose.astro";
import RolesGrid from "../../components/RolesGrid.vue";
import SkillsByGroup from "../../components/SkillsByGroup.astro";
import StructuredData from "../../components/StructuredData.astro";
import TooltipWrapper from "../../components/TooltipWrapper.astro";
import { getSiteUrl } from "../../config/pageMetadata";
import Layout from "../../layouts/Layout.astro";

export async function getStaticPaths() {
  const entries = await getCollection("work");
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props as { entry: CollectionEntry<"work"> };
const { Content } = await render(entry);

const siteUrl = getSiteUrl(Astro.site);
const canonicalUrl = new URL(`/work/${entry.id}`, siteUrl).href;
const description =
  entry.data.headline ?? `${entry.data.type} work from ${entry.data.year}.`;
const isPrivate = entry.data.category === "private";
const ogImage = entry.data.logo?.src ?? `/open-graph/work/${entry.id}.png`;
const ogImageUrl = new URL(String(ogImage), siteUrl).href;
const creativeWorkSchema = {
  "@context": "https://schema.org",
  "@type": "CreativeWork",
  name: entry.data.title,
  description,
  url: canonicalUrl,
  image: ogImageUrl,
  creator: {
    "@type": "Person",
    name: "Andy Merskin",
    url: siteUrl,
  },
  sameAs: entry.data.externalUrl,
};
---

<Layout
  title={entry.data.title}
  description={description}
  canonical={canonicalUrl}
  image={String(ogImage)}
  imageAlt={`${entry.data.title} logo`}
  noindex={isPrivate}
>
  <StructuredData data={creativeWorkSchema} />
  <header>
    {/* Breadcrumb */}
    <nav>
      <a
        class="underline-offset-4 opacity-70 hover:underline hover:opacity-100"
        href={`/work/${entry.data.category}`}>← Work</a
      >
    </nav>

    {/* Headline */}
    <div class="mt-4 text-5xl font-bold tracking-tight">
      {entry.data.headline}
    </div>

    <HRule />

    {/* Title and link */}
    <div class="mt-8 flex items-start justify-between flex-col md:flex-row gap-4">
      <div>
        <h1 class="text-3xl font-bold tracking-tight">{entry.data.title}</h1>
        <div class="mt-2 flex gap-2 text-sm">
          <span class="text-neutral-600 dark:text-neutral-400">
            {entry.data.type}
          </span>
          •
          <span class="text-neutral-600 dark:text-neutral-400">
            {entry.data.year}
          </span>
        </div>
      </div>

      <a
        href={entry.data.externalUrl}
        target="_blank"
        rel="noopener noreferrer"
      >
        <Button>
          Visit project
          <span aria-hidden="true">↗</span>
        </Button>
      </a>
    </div>
  </header>

  <HRule />

  <section class="mt-8">
    <Prose>
      <Content
        components={{ Tooltip: TooltipWrapper, SkillsByGroup, RolesGrid }}
      />
    </Prose>
  </section>
</Layout>
