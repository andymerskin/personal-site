---
import Layout from "../../layouts/Layout.astro";
import Tabs from "../../components/Tabs.astro";
import WorkGrid from "../../components/WorkGrid.vue";
import WorkPrivateGate from "../../components/WorkPrivateGate.vue";
import { getCollection } from "astro:content";

const tabs = [
  { label: "Public", href: "/work/public" },
  { label: "Private", href: "/work/private" },
  { label: "Fun", href: "/work/fun" },
];

const privateEntries = (await getCollection("work")).filter(
  (entry) => entry.data.category === "private",
);

const privateCards = privateEntries.map(({ id, data }) => ({
  id,
  title: data.title,
  type: data.type,
  year: data.year,
  classes: data.classes ?? "",
  logoSrc: String(data.logo.src),
}));
---

<Layout title="Work">
  <div class="flex flex-wrap items-center justify-between gap-4">
    <h1 class="text-5xl font-bold tracking-tight">Work</h1>
    <Tabs tabs={tabs} disableTransitions />
  </div>

  <section class="mt-8">
    <WorkPrivateGate client:load password="hello">
      <WorkGrid entries={privateCards} client:only="vue" />
    </WorkPrivateGate>
  </section>
</Layout>
