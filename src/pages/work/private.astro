---
import { getImage } from "astro:assets";
import { getCollection } from "astro:content";
import StructuredData from "../../components/StructuredData.astro";
import WorkGrid from "../../components/WorkGrid.vue";
import WorkPrivateGate from "../../components/WorkPrivateGate.vue";
import WorkTabs from "../../components/WorkTabs.astro";
import { getSiteUrl, PAGE_METADATA } from "../../config/pageMetadata";
import Layout from "../../layouts/Layout.astro";

const privateEntries = (await getCollection("work")).filter(
  (entry) => entry.data.category === "private",
);

const privateCards = await Promise.all(
  privateEntries.map(async ({ id, data }) => {
    const optimizedLogo = await getImage({
      src: data.logo,
      widths: [200, 400, 600],
      sizes: "(max-width: 639px) 100vw, 50vw",
    });

    return {
      id,
      title: data.title,
      type: data.type,
      year: data.year,
      classes: data.classes ?? "",
      logoAttrs: {
        src: optimizedLogo.src,
        srcset: optimizedLogo.srcSet?.attribute,
        sizes: optimizedLogo.attributes.sizes,
        width: optimizedLogo.attributes.width,
        height: optimizedLogo.attributes.height,
      },
    };
  }),
);

const metadata = PAGE_METADATA["work/private"];
const siteUrl = getSiteUrl(Astro.site);
const collectionSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: metadata.title,
  description: metadata.description,
  url: new URL("/work/private", siteUrl).href,
};
---

<Layout
  title={metadata.title}
  description={metadata.description}
  image="/open-graph/work/private.png"
  noindex
>
  <StructuredData data={collectionSchema} />
  <div class="flex flex-wrap items-center justify-between gap-4">
    <h1 class="text-5xl font-bold tracking-tight">Work</h1>
    {/* <WorkTabs /> */}
  </div>

  <section class="mt-8">
    <WorkPrivateGate client:load password="hello">
      <WorkGrid entries={privateCards} client:only="vue" />
    </WorkPrivateGate>
  </section>
</Layout>
