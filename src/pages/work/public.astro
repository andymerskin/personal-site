---
import { getImage } from "astro:assets";
import { getCollection } from "astro:content";
import Tabs from "../../components/Tabs.astro";
import WorkGrid from "../../components/WorkGrid.vue";
import StructuredData from "../../components/StructuredData.astro";
import { getSiteUrl, PAGE_METADATA } from "../../config/pageMetadata";
import Layout from "../../layouts/Layout.astro";

const tabs = [
  { label: "Public", href: "/work/public" },
  { label: "Private", href: "/work/private" },
  { label: "Fun", href: "/work/fun" },
];

const preferredOrder = [
  "unify",
  "processunity",
  "utb",
  "spriggan",
  "ft",
] as const;

const workItems = (await getCollection("work"))
  .filter((entry) => entry.data.category === "public")
  .sort((a, b) => {
    const aIdx = preferredOrder.indexOf(a.id as any);
    const bIdx = preferredOrder.indexOf(b.id as any);

    if (aIdx !== -1 && bIdx !== -1) return aIdx - bIdx;
    if (aIdx !== -1) return -1;
    if (bIdx !== -1) return 1;

    return a.data.title.localeCompare(b.data.title);
  });

const workCards = await Promise.all(
  workItems.map(async ({ id, data }) => {
    const optimizedLogo = await getImage({
      src: data.logo,
      widths: [200, 400, 600],
      sizes: "(max-width: 639px) 100vw, 50vw",
    });

    return {
      id,
      title: data.title,
      type: data.type,
      year: data.year,
      classes: data.classes ?? "",
      logoAttrs: {
        src: optimizedLogo.src,
        srcset: optimizedLogo.srcSet?.attribute,
        sizes: optimizedLogo.attributes.sizes,
        width: optimizedLogo.attributes.width,
        height: optimizedLogo.attributes.height,
      },
    };
  }),
);

const metadata = PAGE_METADATA["work/public"];
const siteUrl = getSiteUrl(Astro.site);
const collectionSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: metadata.title,
  description: metadata.description,
  url: new URL("/work/public", siteUrl).href,
};
---

<Layout
  title={metadata.title}
  description={metadata.description}
  image="/open-graph/work/public.png"
>
  <StructuredData data={collectionSchema} />
  <div class="flex flex-wrap items-center justify-between gap-4">
    <h1 class="text-5xl font-bold tracking-tight">Work</h1>
    <Tabs tabs={tabs} disableTransitions />
  </div>

  <section class="mt-8">
    <WorkGrid entries={workCards} client:only="vue" />
  </section>
</Layout>
