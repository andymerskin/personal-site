---
import Layout from "../../layouts/Layout.astro";
import Tabs from "../../components/Tabs.astro";
import WorkGrid from "../../components/WorkGrid.vue";
import { getCollection } from "astro:content";

const tabs = [
  { label: "Public", href: "/work/public" },
  { label: "Private", href: "/work/private" },
  { label: "Fun", href: "/work/fun" },
];

const preferredOrder = [
  "unify",
  "processunity",
  "utb",
  "spriggan",
  "ft",
] as const;

const workItems = (await getCollection("work"))
  .filter((entry) => entry.data.category === "public")
  .sort((a, b) => {
    const aIdx = preferredOrder.indexOf(a.id as any);
    const bIdx = preferredOrder.indexOf(b.id as any);

    if (aIdx !== -1 && bIdx !== -1) return aIdx - bIdx;
    if (aIdx !== -1) return -1;
    if (bIdx !== -1) return 1;

    return a.data.title.localeCompare(b.data.title);
  });

const workCards = workItems.map(({ id, data }) => ({
  id,
  title: data.title,
  type: data.type,
  year: data.year,
  classes: data.classes ?? "",
  logoSrc: String(data.logo.src),
}));
---

<Layout title="Work">
  <div class="flex flex-wrap items-center justify-between gap-4">
    <h1 class="text-5xl font-bold tracking-tight">Work</h1>
    <Tabs tabs={tabs} disableTransitions />
  </div>

  <section class="mt-8">
    <WorkGrid entries={workCards} client:only="vue" />
  </section>
</Layout>
