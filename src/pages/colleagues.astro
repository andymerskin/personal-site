---
import { getCollection } from "astro:content";
import { createMarkdownProcessor } from "@astrojs/markdown-remark";
import InfiniteScroller from "../components/InfiniteScroller.vue";
import RecommendationCard from "../components/RecommendationCard.astro";
import Layout from "../layouts/Layout.astro";

const rawRecommendations = await getCollection("recommendations");
const markdown = await createMarkdownProcessor();

const recommendations = await Promise.all(
  rawRecommendations
    .sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0))
    .map(async (rec) => {
      const { code } = await markdown.render(rec.body ?? "");

      return {
        ...rec,
        body: code,
      };
    }),
);
---

<Layout title="Colleagues">
  <h1 class="text-5xl font-bold tracking-tight">
    Building great teams starts with caring for your people
  </h1>

  <p
    class="mt-6 text-xl leading-relaxed text-neutral-700 dark:text-neutral-300"
  >
    Here are some reflections from colleagues who've experienced firsthand how
    working with me creates environments where supporting and empowering people
    leads to innovation.
  </p>

  <p class="mt-4 text-sm text-neutral-600 dark:text-neutral-400">
    ❤️ Thanks to all of my colleagues who took the time to write a reflection.
  </p>

  <div
    class="card-base my-16 -rotate-1 transition-transform duration-1200 hover:rotate-0 dark:bg-cyan-700/40!"
  >
    <p
      class="group flex items-center justify-between text-neutral-600 dark:text-cyan-400"
    >
      <span
        class="font-display text-3xl leading-none font-bold transition-colors dark:group-hover:text-white"
        >Need a recommendation?</span
      >
      <a
        href="https://www.linkedin.com/in/andymerskin/"
        rel="noopener noreferrer"
        class="decoration-amber-500 decoration-2 transition-colors hover:underline dark:group-hover:text-white"
        >Request <i
          class="ri-linkedin-box-fill align-bottom text-2xl leading-none"
        ></i></a
      >
    </p>
  </div>

  <!-- Recommendation items -->
  <InfiniteScroller
    itemClass="recommendation-entry"
    :batchSize="5"
    client:only="vue"
  >
    <div class="space-y-12">
      {
        recommendations.map((recommendation) => (
          <RecommendationCard recommendation={recommendation.data}>
            <div set:html={recommendation.body} />
          </RecommendationCard>
        ))
      }
    </div>
  </InfiniteScroller>
</Layout>
