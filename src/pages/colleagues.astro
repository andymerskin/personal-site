---
import { getCollection } from "astro:content";
import { createMarkdownProcessor } from "@astrojs/markdown-remark";
import InfiniteScroller from "../components/InfiniteScroller.vue";
import RecommendationCard from "../components/RecommendationCard.astro";
import StructuredData from "../components/StructuredData.astro";
import { getSiteUrl, PAGE_METADATA } from "../config/pageMetadata";
import Layout from "../layouts/Layout.astro";

const rawRecommendations = await getCollection("recommendations");
const markdown = await createMarkdownProcessor();

const recommendations = await Promise.all(
  rawRecommendations
    .sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0))
    .map(async (rec) => {
      const { code } = await markdown.render(rec.body ?? "");

      return {
        ...rec,
        body: code,
      };
    }),
);

const metadata = PAGE_METADATA.colleagues;
const siteUrl = getSiteUrl(Astro.site);
const collectionSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: metadata.title,
  description: metadata.description,
  url: new URL("/colleagues", siteUrl).href,
};
---

<Layout
  title={metadata.title}
  description={metadata.description}
  image="/open-graph/colleagues.png"
>
  <StructuredData data={collectionSchema} />
  <h1 class="text-5xl font-bold tracking-tight">
    Building great teams starts with caring for your people
  </h1>

  <p
    class="mt-6 text-xl leading-relaxed text-neutral-700 dark:text-neutral-300"
  >
    Here are some reflections from colleagues who've experienced firsthand how
    working with me creates environments where supporting and empowering people
    leads to innovation.
  </p>

  <p class="mt-4 text-sm text-neutral-600 dark:text-neutral-400">
    ❤️ Thanks to all of my colleagues who took the time to write a reflection.
  </p>

  <div
    class="card-base my-16 -rotate-1 transition-transform duration-1200 hover:rotate-0 dark:bg-cyan-700/40!"
  >
    <p
      class="group flex items-center justify-between text-neutral-600 dark:text-cyan-400"
    >
      <span
        class="font-display text-3xl leading-none font-bold transition-colors dark:group-hover:text-white"
        >Need a recommendation?</span
      >
      <a
        href="https://www.linkedin.com/in/andymerskin/"
        rel="noopener noreferrer"
        class="decoration-amber-500 decoration-2 transition-colors hover:underline dark:group-hover:text-white"
        >Request <i
          class="ri-linkedin-box-fill align-bottom text-2xl leading-none"
        ></i></a
      >
    </p>
  </div>

  {/* Recommendation items */}
  <InfiniteScroller
    itemClass="recommendation-entry"
    :batchSize="5"
    client:only="vue"
  >
    <div class="space-y-12">
      {
        recommendations.map((recommendation) => (
          <RecommendationCard
            recommendation={recommendation.data}
            id={recommendation.id}
          >
            <div set:html={recommendation.body} />
          </RecommendationCard>
        ))
      }
    </div>
  </InfiniteScroller>
</Layout>

<script>
  function scrollToAnchor(): void {
    const hash = window.location.hash;
    if (!hash) return;

    const targetId = hash.slice(1); // Remove the # symbol
    const targetElement = document.getElementById(targetId);

    if (!targetElement) {
      // If element not found, wait a bit for InfiniteScroller to render
      setTimeout(() => {
        const retryElement = document.getElementById(targetId);
        if (retryElement) {
          const elementPosition = retryElement.getBoundingClientRect().top;
          const offsetPosition = elementPosition + window.pageYOffset - 48;
          window.scrollTo({
            top: offsetPosition,
            behavior: "smooth",
          });
        }
      }, 100);
      return;
    }

    // Scroll to the element with 48px offset from the top
    const elementPosition = targetElement.getBoundingClientRect().top;
    const offsetPosition = elementPosition + window.pageYOffset - 48;
    window.scrollTo({
      top: offsetPosition,
      behavior: "smooth",
    });
  }

  // Handle initial page load
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", () => {
      setTimeout(scrollToAnchor, 200); // Small delay to ensure InfiniteScroller has rendered
    });
  } else {
    setTimeout(scrollToAnchor, 200);
  }

  // Handle Astro view transitions
  document.addEventListener("astro:page-load", () => {
    setTimeout(scrollToAnchor, 200);
  });
</script>
