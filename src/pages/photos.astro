---
import { getImage } from "astro:assets";
import { getCollection } from "astro:content";
import PhotosGallery from "../components/PhotosGallery.vue";
import StructuredData from "../components/StructuredData.astro";
import { getSiteUrl, PAGE_METADATA } from "../config/pageMetadata";
import Layout from "../layouts/Layout.astro";

const photos = await getCollection("photos");
const photoItems = await Promise.all(
  photos.map(async (photo) => {
    const thumb = await getImage({
      src: photo.data.src,
      widths: [360, 600],
      sizes: "(max-width: 639px) 600px, 360px",
    });

    const full = await getImage({
      src: photo.data.src,
      width: 3840,
    });

    return {
      id: photo.id,
      caption: photo.data.caption,
      thumbAttrs: {
        src: thumb.src,
        srcset: thumb.srcSet?.attribute,
        sizes: thumb.attributes.sizes,
        width: thumb.attributes.width,
        height: thumb.attributes.height,
      },
      fullAttrs: {
        src: full.src,
        width: full.attributes.width,
        height: full.attributes.height,
      },
    };
  }),
);

const metadata = PAGE_METADATA.photos;
const siteUrl = getSiteUrl(Astro.site);
const collectionSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: metadata.title,
  description: metadata.description,
  url: new URL("/photos", siteUrl).href,
};
---

<Layout
  title={metadata.title}
  description={metadata.description}
  image="/open-graph/photos.png"
>
  <StructuredData data={collectionSchema} />
  <h1 class="text-5xl font-bold tracking-tight">{metadata.title}</h1>
  <p
    class="mt-6 text-xl leading-relaxed text-neutral-700 dark:text-neutral-300"
  >
    {metadata.description}
  </p>
  <div class="mt-8">
    {
      photos.length === 0 ? (
        <p class="text-neutral-600 dark:text-neutral-400">No photos yet.</p>
      ) : (
        <PhotosGallery photos={photoItems} client:load />
      )
    }
  </div>
</Layout>
