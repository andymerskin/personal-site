---
import Layout from "../layouts/Layout.astro";
import WorkCard from "../components/WorkCard.astro";
import { getCollection } from "astro:content";

const preferredOrder = [
  "unify",
  "processunity",
  "ft",
  "utb",
] as const;

const workItems = (await getCollection("work")).sort((a, b) => {
  const aIdx = preferredOrder.indexOf(a.id as (typeof preferredOrder)[number]);
  const bIdx = preferredOrder.indexOf(b.id as (typeof preferredOrder)[number]);

  if (aIdx === -1 && bIdx === -1) return a.id.localeCompare(b.id);
  if (aIdx === -1) return 1;
  if (bIdx === -1) return -1;
  return aIdx - bIdx;
});
---

<Layout title="Work">
  <h1 class="text-5xl font-bold tracking-tight">Work</h1>

  <section class="mt-8">
    <ul class="grid grid-cols-2 gap-x-5 gap-y-8">
      {
        workItems.map((entry) => (
          <WorkCard entry={entry} />
        ))
      }
    </ul>
  </section>
</Layout>
