---
import "../styles/global.css";
import "../styles/fonts.css";
import "remixicon/fonts/remixicon.css";
import { ClientRouter } from "astro:transitions";
import { SEO } from "astro-seo";
import LocationBadge from "../components/LocationBadge.astro";
import ProfileImage from "../components/ProfileImage.astro";
import SideNav from "../components/SideNav.astro";
import MobileNav from "../components/MobileNav.astro";
import StarsBackground from "../components/StarsBackground.vue";
import ThemeToggle from "../components/ThemeToggle.astro";
import { DEFAULT_DESCRIPTION } from "../config/pageMetadata";

export interface Props {
  title?: string;
  titleTemplate?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  canonical?: string;
  noindex?: boolean;
  nofollow?: boolean;
  ogType?: string;
  ogTitle?: string;
}

const BASE_TITLE = "Andy Merskin";
const DEFAULT_OG_PATH = "/open-graph/hello.png";

const {
  title,
  titleTemplate = `%s • ${BASE_TITLE}`,
  description = DEFAULT_DESCRIPTION,
  image,
  imageAlt = `${BASE_TITLE} — Personal Site`,
  canonical,
  noindex = false,
  nofollow = false,
  ogType = "website",
  ogTitle,
} = Astro.props;

const fullTitle = title ? titleTemplate.replace("%s", title) : BASE_TITLE;
const ogImageUrl = new URL(image ?? DEFAULT_OG_PATH, Astro.site).href;
const canonicalUrl = canonical ?? Astro.url.href;
---

<!doctype html>
<html lang="en" data-theme-ready="true" transition:animate="none">
  <head>
    <meta charset="utf-8" />
    <SEO
      title={title}
      titleTemplate={titleTemplate}
      titleDefault={BASE_TITLE}
      description={description}
      canonical={canonicalUrl}
      noindex={noindex}
      nofollow={nofollow}
      openGraph={{
        basic: {
          title: ogTitle ?? fullTitle,
          type: ogType,
          image: ogImageUrl,
          url: canonicalUrl,
        },
        optional: {
          description,
          siteName: BASE_TITLE,
        },
        image: {
          alt: imageAlt,
          width: 1200,
          height: 630,
          type: "image/png",
        },
      }}
      twitter={{
        card: "summary_large_image",
        title: ogTitle ?? fullTitle,
        description,
        image: ogImageUrl,
        imageAlt,
      }}
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.ico" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <ClientRouter />
    <!-- Theme initialization -->
    <script is:inline>
      (() => {
        const doc = document.documentElement;
        const applyTheme = () => {
          try {
            const stored = localStorage.getItem("themeMode");
            const mode =
              stored === "dark"
                ? "dark"
                : stored === "light"
                  ? "light"
                  : undefined;
            if (mode) {
              doc.classList.toggle("dark", mode === "dark");
              doc.dataset.themeMode = mode;
            } else {
              doc.classList.remove("dark");
              delete doc.dataset.themeMode;
            }
          } catch (err) {
            console.warn("Theme init failed", err);
          }
        };

        // Always apply theme, even if initialization already ran
        applyTheme();

        // Only run full initialization once
        if (window.__themeHeadInit) {
          doc.dataset.themeReady = "true";
          return;
        }
        window.__themeHeadInit = true;

        doc.dataset.themeReady = "true";
      })();
    </script>
    <!-- Skip view transitions for elements with data-astro-skip-transition="true" -->
    <script is:inline>
      document.addEventListener("astro:before-swap", (event) => {
        const source = event.sourceElement;
        const shouldSkip =
          source && source instanceof HTMLElement
            ? source.dataset.astroSkipTransition === "true"
            : false;

        if (shouldSkip) {
          event.viewTransition?.skipTransition();
        }
      });
    </script>
  </head>
  <body
    class="bg-primary
    text-neutral-900
    transition-colors
    duration-300
    ease-in-out
    dark:bg-neutral-950
    dark:text-neutral-50"
  >
    <!-- Dark mode stars -->
    <StarsBackground
      heightFactor={0.5}
      class="hidden dark:block"
      client:load
      transition:persist
    />

    <div class="mx-auto max-w-5xl px-4 md:px-16 pt-8 lg:pt-16 pb-32">
      <!-- Mobile header -->
      <header class="md:mb-16 lg:hidden md:flex md:items-start md:justify-between md:gap-8">
        <MobileNav />
        <div class="flex flex-col items-center md:items-start">
          <div class="flex items-center justify-center md:justify-start">
            <a href="/">
              <ProfileImage />
            </a>
          </div>
          <div class="mb-8 flex flex-col items-center md:mb-0 md:items-start">
            <div class="ml-6 flex items-center md:ml-0">
              <a
                href="/"
                class="decoration-amber-500 decoration-2 hover:underline"
              >
                <h1 class="text-xl font-bold">{BASE_TITLE}</h1>
              </a>
              <ThemeToggle transition:persist />
            </div>
            <LocationBadge />
          </div>
        </div>
        <div class="hidden md:flex md:flex-1 md:items-start md:mt-4">
          <SideNav orientation="horizontal" />
        </div>
      </header>

      <!-- Desktop header -->
      <div class="lg:flex lg:gap-10">
        <aside class="hidden lg:block lg:w-56">
          <a href="/">
            <ProfileImage />
          </a>
          <div class="mb-8">
            <div class="flex items-center">
              <a
                href="/"
                class="decoration-amber-500 decoration-2 hover:underline"
              >
                <h1 class="text-xl font-bold">{BASE_TITLE}</h1>
              </a>
              <ThemeToggle transition:persist />
            </div>
            <LocationBadge />
          </div>
          <SideNav orientation="vertical" />
        </aside>

        <main class="min-w-0 flex-1">
          <slot />
        </main>
      </div>
    </div>
  </body>
</html>
