---
import "../styles/global.css";
import SideNav from "../components/SideNav.astro";
import ThemeToggle from "../components/ThemeToggle.vue";

export interface Props {
  title?: string;
  titleTemplate?: (pageTitle: string, baseTitle: string) => string;
}

const BASE_TITLE = "Andy Merskin";

const { title, titleTemplate } = Astro.props;

const fullTitle = title
  ? (titleTemplate?.(title, BASE_TITLE) ?? `${BASE_TITLE} • ${title}`)
  : BASE_TITLE;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{fullTitle}</title>
    <script src="../scripts/themeMode.ts"></script>
  </head>
  <body
    class="bg-primary text-neutral-900 dark:bg-neutral-950 dark:text-neutral-50 transition-colors duration-300 ease-in-out"
  >
    <div class="mx-auto max-w-5xl px-4 pt-16 pb-32">
      <header class="mb-8 md:hidden">
        <div class="flex items-center gap-2 mb-8">
          <h1 class="text-xl font-bold">{BASE_TITLE}</h1>
          <ThemeToggle client:load class="relative top-0.5" />
        </div>
        <SideNav orientation="horizontal" />
      </header>

      <div class="md:flex md:gap-10">
        <aside class="hidden md:block md:w-40 lg:w-56">
          <div class="flex items-center gap-2 mb-8">
            <h1 class="text-xl font-bold">{BASE_TITLE}</h1>
            <ThemeToggle client:load class="relative top-0.5" />
          </div>
          <SideNav orientation="vertical" />
        </aside>

        <main class="min-w-0 flex-1">
          <slot />
        </main>
      </div>
    </div>
  </body>
</html>
