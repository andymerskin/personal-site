---
import "../styles/global.css";
import "../styles/fonts.css";
import "remixicon/fonts/remixicon.css";
import SideNav from "../components/SideNav.astro";
import ThemeToggle from "../components/ThemeToggle.astro";
import { Image } from "astro:assets";
import andy from "../images/andy.jpg";
import LocationBadge from "../components/LocationBadge.astro";

export interface Props {
  title?: string;
  titleTemplate?: (pageTitle: string, baseTitle: string) => string;
}

const BASE_TITLE = "Andy Merskin";

const { title, titleTemplate } = Astro.props;

const fullTitle = title
  ? (titleTemplate?.(title, BASE_TITLE) ?? `${BASE_TITLE} • ${title}`)
  : BASE_TITLE;
---

<!doctype html>
<html lang="en" data-theme-ready="true">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.ico" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <script is:inline>
      try {
        const doc = document.documentElement;
        const stored = localStorage.getItem("themeMode");
        const mode =
          stored === "dark" ? "dark" : stored === "light" ? "light" : undefined;
        if (mode) {
          doc.classList.toggle("dark", mode === "dark");
          doc.dataset.themeMode = mode;
        } else {
          doc.classList.remove("dark");
          delete doc.dataset.themeMode;
        }
      } catch (err) {
        console.warn("Theme init failed", err);
      } finally {
        document.documentElement.dataset.themeReady = "true";
      }
    </script>
    <title>{fullTitle}</title>
  </head>
  <body
    class="bg-primary
    text-neutral-900
    transition-colors
    duration-300
    ease-in-out
    dark:bg-neutral-950
    dark:text-neutral-50"
  >
    <div class="mx-auto max-w-5xl px-4 pt-16 pb-32">
      <!-- Mobile header -->
      <header class="mb-8 lg:hidden">
        <div class="flex items-center justify-center">
          <Image
            src={andy}
            alt="Andy Merskin"
            width={128}
            height={128}
            class="max-h-full w-auto rounded-full object-cover"
          />
        </div>
        <div class="mb-8 flex flex-col items-center">
          <div class="flex items-center ml-6">
            <h1 class="text-xl font-bold">{BASE_TITLE}</h1>
            <ThemeToggle />
          </div>
          <LocationBadge />
        </div>
        <SideNav orientation="horizontal" />
      </header>

      <!-- Desktop header -->
      <div class="lg:flex lg:gap-10">
        <aside class="hidden lg:block lg:w-56">
          <Image
            src={andy}
            alt="Andy Merskin"
            width={128}
            height={128}
            class="max-h-full w-auto rounded-full object-cover"
          />
          <div class="mb-8">
            <div class="flex items-center">
              <h1 class="text-xl font-bold">{BASE_TITLE}</h1>
              <ThemeToggle />
            </div>
            <LocationBadge />
          </div>
          <SideNav orientation="vertical" />
        </aside>

        <main class="min-w-0 flex-1">
          <slot />
        </main>
      </div>
    </div>
  </body>
</html>
