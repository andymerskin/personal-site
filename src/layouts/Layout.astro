---
import "../styles/global.css";
import "../styles/fonts.css";
import "remixicon/fonts/remixicon.css";
import { ClientRouter } from "astro:transitions";
import { SEO } from "astro-seo";
import LocationBadge from "../components/LocationBadge.astro";
import ProfileImage from "../components/ProfileImage.astro";
import SideNav from "../components/SideNav.astro";
import MobileNav from "../components/MobileNav.astro";
import BackToTopButton from "../components/BackToTopButton.vue";
import ScrollNavBar from "../components/ScrollNavBar.vue";
import ScrollSideNav from "../components/ScrollSideNav.vue";
import StarsBackground from "../components/StarsBackground.vue";
import ThemeToggle from "../components/ThemeToggle.vue";
import {
  EXTERNAL_NAV_ITEMS,
  NAV_ITEMS,
  isActiveNavItem,
  normalizePathname,
  getNavLinkAttributes,
} from "../config/navigation";
import { DEFAULT_DESCRIPTION, SITE_NAME } from "../config/pageMetadata";

export interface Props {
  title?: string;
  titleTemplate?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  canonical?: string;
  noindex?: boolean;
  nofollow?: boolean;
  ogType?: string;
  ogTitle?: string;
}

const DEFAULT_OG_PATH = "/open-graph/hello.png";

const {
  title,
  titleTemplate = `%s • ${SITE_NAME}`,
  description = DEFAULT_DESCRIPTION,
  image,
  imageAlt = `${SITE_NAME} — Personal Site`,
  canonical,
  noindex = false,
  nofollow = false,
  ogType = "website",
  ogTitle,
} = Astro.props;

const fullTitle = title ? titleTemplate.replace("%s", title) : SITE_NAME;
const ogImageUrl = new URL(image ?? DEFAULT_OG_PATH, Astro.site).href;
const canonicalUrl = canonical ?? Astro.url.href;
const currentPath = normalizePathname(Astro.url.pathname);
---

<!doctype html>
<html lang="en" data-theme-ready="true" transition:animate="none">
  <head>
    <meta charset="utf-8" />
    <SEO
      title={title}
      titleTemplate={titleTemplate}
      titleDefault={SITE_NAME}
      description={description}
      canonical={canonicalUrl}
      noindex={noindex}
      nofollow={nofollow}
      openGraph={{
        basic: {
          title: ogTitle ?? fullTitle,
          type: ogType,
          image: ogImageUrl,
          url: canonicalUrl,
        },
        optional: {
          description,
          siteName: SITE_NAME,
        },
        image: {
          alt: imageAlt,
          width: 1200,
          height: 630,
          type: "image/png",
        },
      }}
      twitter={{
        card: "summary_large_image",
        title: ogTitle ?? fullTitle,
        description,
        image: ogImageUrl,
        imageAlt,
      }}
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.ico" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <ClientRouter />
    <!-- Theme initialization -->
    <script is:inline>
      (() => {
        const doc = document.documentElement;
        const applyTheme = () => {
          try {
            const stored = localStorage.getItem("themeMode");
            const mode =
              stored === "dark"
                ? "dark"
                : stored === "light"
                  ? "light"
                  : undefined;
            if (mode) {
              doc.classList.toggle("dark", mode === "dark");
              doc.dataset.themeMode = mode;
            } else {
              doc.classList.remove("dark");
              delete doc.dataset.themeMode;
            }
          } catch (err) {
            console.warn("Theme init failed", err);
          }
        };

        // Always apply theme, even if initialization already ran
        applyTheme();

        // Only run full initialization once
        if (window.__themeHeadInit) {
          doc.dataset.themeReady = "true";
          return;
        }
        window.__themeHeadInit = true;

        doc.dataset.themeReady = "true";
      })();
    </script>
    <!-- Skip view transitions for elements with data-astro-skip-transition="true" -->
    <script is:inline>
      document.addEventListener("astro:before-swap", (event) => {
        const source = event.sourceElement;
        const shouldSkip =
          source && source instanceof HTMLElement
            ? source.dataset.astroSkipTransition === "true"
            : false;

        if (shouldSkip) {
          event.viewTransition?.skipTransition();
        }
      });
    </script>
  </head>
  <body
    class="bg-primary
    text-neutral-900
    transition-colors
    duration-300
    ease-in-out
    dark:bg-neutral-950
    dark:text-neutral-50"
  >
    <!-- Dark mode stars -->
    <StarsBackground
      heightFactor={0.5}
      class="hidden dark:block -z-10"
      client:load
      transition:persist
      transition:name="stars-background"
    />

    <!-- Scroll-based navigation bar (md-lg breakpoints) -->
    <ScrollNavBar client:load />

    <!-- Scroll-based sidebar navigation (xl breakpoint) -->
    <ScrollSideNav client:load />

    <div class="mx-auto max-w-5xl px-4 md:px-16 lg:px-4 pt-8 lg:pt-16 pb-32">
      <!-- Mobile header -->
      <header class="mb-8 md:mb-16 lg:hidden flex flex-col items-center md:items-start">
        <MobileNav />
        <div class="flex w-full flex-col items-center md:items-start">
          <div class="flex flex-col items-center md:flex-row md:items-start md:gap-4">
            <a href="/">
              <ProfileImage />
            </a>
            <div class="flex flex-col items-center md:items-start">
              <div class="flex items-center ml-4 md:ml-0">
                <a
                  href="/"
                  class="decoration-amber-500 decoration-2 hover:underline"
                >
                  <h1 class="text-xl font-bold">{SITE_NAME}</h1>
                </a>
                <ThemeToggle
                  client:load
                  transition:persist
                  transition:name="theme-toggle-mobile"
                />
              </div>
              <LocationBadge />
              <ul class="hidden items-center gap-x-3 md:flex">
                {EXTERNAL_NAV_ITEMS.map((item) => (
                  <li>
                    <a
                      href={item.href}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-flex items-center py-1 opacity-66 hover:opacity-100"
                      aria-label={item.label}
                    >
                      <i class:list={[item.icon, "text-2xl"]} />
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          </div>
          <ul class="mt-6 hidden flex-wrap items-center justify-start gap-x-6 gap-y-2 md:flex">
            {NAV_ITEMS.map((item) => {
              const itemPath = normalizePathname(item.href);
              const isActive = isActiveNavItem(currentPath, item);
              const linkAttributes = getNavLinkAttributes(item);

              return (
                <li>
                  <a
                    href={itemPath}
                    {...linkAttributes}
                    class:list={[
                      "inline-flex items-center py-1 hover:opacity-100",
                      isActive
                        ? "font-bold underline decoration-amber-500 decoration-2 underline-offset-4"
                        : "font-medium opacity-66",
                    ]}
                    aria-current={isActive ? "page" : undefined}
                  >
                    {item.label}
                  </a>
                </li>
              );
            })}
          </ul>
        </div>
      </header>

      <!-- Desktop header -->
      <div class="lg:flex lg:gap-10">
        <aside class="hidden lg:block lg:w-56">
          <a href="/">
            <ProfileImage />
          </a>
          <div class="mb-8">
            <div class="flex items-center">
              <a
                href="/"
                class="decoration-amber-500 decoration-2 hover:underline"
              >
                <h1 class="text-xl font-bold">{SITE_NAME}</h1>
              </a>
              <ThemeToggle
                client:load
                transition:persist
                transition:name="theme-toggle-desktop"
              />
            </div>
            <LocationBadge />
          </div>
          <SideNav orientation="vertical" />
        </aside>

        <main class="min-w-0 flex-1">
          <slot />
        </main>
      </div>
    </div>

    <BackToTopButton client:load />
  </body>
</html>
