---
import { getCollection } from "astro:content";
import type { SkillId } from "../content/skills.gen";

export interface Props {
  skills: SkillId[];
  heading: string;
}

const { skills: skillSlugs, heading } = Astro.props;

// Get all skills from the collection
const allSkills = await getCollection("skills");

type Skill = (typeof allSkills)[number];

const isSkill = (value: Skill | undefined): value is Skill => Boolean(value);

// Create a map for quick lookup
const skillsMap = new Map<SkillId, Skill>();
allSkills.forEach((skill) => {
  skillsMap.set(skill.id as SkillId, skill);
});

// Get the skill data for the provided slugs and sort by name
const skillData = skillSlugs
  .map((slug) => skillsMap.get(slug))
  .filter(isSkill)
  .sort((a: Skill, b: Skill) => a.data.name.localeCompare(b.data.name));
---

<div>
  <h4 class="mb-3 text-sm font-semibold text-gray-900 dark:text-gray-100">
    {heading}
  </h4>
  <!-- prettier-ignore -->
  <ul style="--list-disc-icon: '&#xEA6E';"
    class="list-(--list-disc-icon) space-y-1 pl-3"
  >
    {
      skillData.map((skill) => (
        <li class="marker:font-icon pl-1 text-sm text-gray-700 marker:text-amber-600 dark:text-gray-300 dark:marker:text-amber-500">
          <span>{skill.data.name}</span>
        </li>
      ))
    }
  </ul>
</div>
