---
import { getCollection } from "astro:content";
import { SKILL_TYPE_ORDER } from "../content.config.ts";
import SkillTag from "./SkillTag.astro";

export interface Props {
  skills: string[];
}

const { skills: skillSlugs } = Astro.props;

// Get all skills from the collection
const allSkills = await getCollection("skills");

type Skill = (typeof allSkills)[number];

// Create a map for quick lookup
const skillsMap = new Map();
allSkills.forEach((skill: Skill) => {
  skillsMap.set(skill.id, skill);
});

// Get the skill data for the provided slugs
const skillData = skillSlugs.map((slug) => skillsMap.get(slug)).filter(Boolean); // Remove any undefined entries

// Group by type and sort within each group
const groupedSkills = skillData.reduce(
  (acc, skill) => {
    const type = skill.data.type;
    if (!acc[type]) {
      acc[type] = [];
    }
    acc[type].push(skill);
    return acc;
  },
  {} as Record<string, Skill[]>,
);

// Sort within each group by name
Object.keys(groupedSkills).forEach((type) => {
  groupedSkills[type].sort((a: Skill, b: Skill) =>
    a.data.name.localeCompare(b.data.name),
  );
});

// Use the shared skill type order from content config
---

<div class="flex flex-col gap-3">
  {
    SKILL_TYPE_ORDER.map((type) => {
      const skills = groupedSkills[type];
      if (!skills || skills.length === 0) return null;

      return (
        <div class="flex flex-wrap gap-2">
          {skills.map((skill: Skill) => (
            <SkillTag skill={skill.id} />
          ))}
        </div>
      );
    })
  }
</div>
