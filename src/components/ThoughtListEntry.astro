---
export interface Props {
  class?: string;
  thought: {
    id: string;
    data: {
      date: Date;
      tags: string[];
    };
    body?: string;
  };
}

const { thought, class: className } = Astro.props;

const formatDate = (date: Date) => {
  return new Intl.DateTimeFormat("en-US", {
    month: "short",
    day: "numeric",
    year: "numeric",
  }).format(date);
};
---

<article class:list={["flex gap-12", className]}>
  <div
    class="w-20 flex-none text-sm leading-relaxed whitespace-nowrap text-neutral-500 dark:text-neutral-400 dark:font-medium"
  >
    {formatDate(thought.data.date)}
  </div>
  <p class="text-base leading-relaxed text-neutral-800 dark:text-neutral-200">
    {thought.body}
  </p>
</article>
