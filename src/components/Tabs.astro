---
export type TabsProps = {
  tabs: { label: string; href: string }[];
  disableTransitions?: boolean;
};

const { tabs, disableTransitions = false } = Astro.props as TabsProps;
const currentPath = Astro.url?.pathname ?? "";

const normalizePath = (path: string) =>
  path.length > 1 ? path.replace(/\/$/, "") : path;

const normalizedCurrent = normalizePath(currentPath);
---

<div class="inline-flex rounded-lg shadow-sm">
  {
    tabs.map((tab, index) => {
      const normalizedHref = normalizePath(tab.href);
      const isActive = normalizedCurrent === normalizedHref;

      return (
        <a
          href={tab.href}
          aria-current={isActive ? "page" : undefined}
          data-astro-skip-transition={disableTransitions ? "true" : undefined}
          class:list={[
            "inline-flex",
            "items-center",
            "px-4",
            "py-2",
            "first:rounded-l-lg",
            "last:rounded-r-lg",
            "text-sm",
            "font-semibold",
            "text-neutral-900",
            "no-underline!",
            "bg-white",
            "ring-1",
            "ring-shade-primary/5",
            "hover:bg-shade-primary/5",
            "hover:ring-shade-primary/10",
            "hover:z-10",
            "focus:z-10",
            "focus:ring-2",
            "focus:ring-amber-500",
            "focus:outline-none",
            "dark:ring-neutral-800",
            "dark:bg-neutral-900",
            "dark:text-neutral-100",
            "dark:hover:bg-neutral-800",
            "dark:hover:ring-neutral-700",
            "dark:hover:z-10",
            index > 0 && "border-l border-neutral-200 dark:border-neutral-800",
            isActive &&
              "bg-shade-primary/5! ring-shade-primary/10 font-bold dark:bg-neutral-800! dark:ring-neutral-700! dark:font-bold z-10",
          ]}
        >
          {tab.label}
        </a>
      );
    })
  }
</div>
