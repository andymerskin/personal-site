---
import { getCollection } from "astro:content";
import { SKILL_TYPE_ORDER } from "../content.config.ts";
import type { SkillId } from "../content/skills.gen";
import SkillCard from "./SkillCard.astro";

export interface Props {
  skills: SkillId[];
  class?: string;
  groupByType?: boolean;
}

const { skills: skillIds, class: className, groupByType = false } = Astro.props;

const allSkills = await getCollection("skills");
const skillsMap = new Map(allSkills.map((skill) => [skill.id, skill]));
const skills = skillIds
  .map((id) => skillsMap.get(id))
  .filter((s): s is NonNullable<typeof s> => !!s);

const skillsByType = groupByType
  ? skills.reduce(
      (acc, skill) => {
        const type = skill.data.type;
        if (!acc[type]) {
          acc[type] = [];
        }
        acc[type].push(skill);
        return acc;
      },
      {} as Record<string, typeof skills>,
    )
  : {};

Object.keys(skillsByType).forEach((type) => {
  skillsByType[type].sort((a, b) => a.data.name.localeCompare(b.data.name));
});

const orderedTypes = groupByType
  ? SKILL_TYPE_ORDER.filter((type) => skillsByType[type]?.length)
  : [];

const formatTypeName = (type: string) => {
  return type.charAt(0).toUpperCase() + type.slice(1);
};

---

{
  groupByType ? (
    <div class:list={["space-y-8", className]}>
      {orderedTypes.map((type) => (
        <div class="space-y-4">
          <h3 class="text-xl font-bold">{formatTypeName(type)}</h3>
          <div class="grid grid-cols-1 items-start gap-4 md:grid-cols-2">
            {skillsByType[type].map((skill) => (
              <SkillCard
                name={skill.data.name}
                icon={skill.data.icon}
                compact
                titleAs="h4"
                titleClass="dark:font-medium"
              />
            ))}
          </div>
        </div>
      ))}
    </div>
  ) : (
    <div
      class:list={[
        `grid grid-cols-1 items-start gap-4 md:grid-cols-2`,
        className,
      ]}
    >
      {skills.map((skill) => (
        <SkillCard name={skill.data.name} icon={skill.data.icon} />
      ))}
    </div>
  )
}
