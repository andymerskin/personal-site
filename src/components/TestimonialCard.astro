---
import { Image } from "astro:assets";
import Prose from "./Prose.astro";

export interface Props {
  author: string;
  photo: ImageMetadata;
  job: string;
}

const { author, photo: photoProp, job } = Astro.props;
---

<div class="group relative flex items-start gap-4 even:flex-row-reverse">
  <Image
    src={photoProp}
    width={64}
    height={64}
    alt={author}
    class="absolute mt-3 h-16 w-16 rounded-full group-odd:left-2 group-even:right-2"
  />
  <div
    class="bg-shade-primary/3 rounded-lg p-6 group-odd:ml-12 group-odd:pl-10 group-even:mr-12 group-even:pr-10 dark:bg-neutral-900"
  >
    <Prose class="prose-sm leading-relaxed [&_p:first-child]:mt-0">
      <slot />
    </Prose>
    <div class="mt-2 flex items-center gap-4 group-even:flex-row-reverse">
      <div class="font-display text-2xl font-bold">
        {author}
      </div>
      <div
        class="relative top-0.5 text-sm text-neutral-500 dark:text-neutral-400"
      >
        {job}
      </div>
    </div>
  </div>
</div>
