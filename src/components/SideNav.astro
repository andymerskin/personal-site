---
import ThemeToggle from "./ThemeToggle.vue";

export interface Props {
  orientation?: "horizontal" | "vertical";
  class?: string;
}

const { orientation = "vertical", class: className } = Astro.props;

const items = [
  { href: "/hello", label: "Hello!" },
  { href: "/work", label: "Work" },
  { href: "/blog", label: "Blog" },
  { href: "/thoughts", label: "Thoughts" },
] as const;

const normalizePathname = (pathname: string) => {
  if (pathname === "/") return "/";
  return pathname.endsWith("/") ? pathname.slice(0, -1) : pathname;
};

const current = normalizePathname(Astro.url.pathname);
---

<nav aria-label="Primary" class={className}>
  <ul
    class:list={[
      "gap-x-6 gap-y-3 text-sm",
      orientation === "horizontal" ? "flex flex-wrap items-center" : "flex flex-col",
    ]}
  >
    {
      items.map((item) => {
        const isActive = normalizePathname(item.href) === current;

        return (
          <li>
            <a
              href={item.href}
              class:list={[
                "inline-flex items-center py-1 hover:opacity-100",
                isActive
                  ? "font-semibold underline underline-offset-4 decoration-amber-500 decoration-2"
                  : "opacity-66",
              ]}
              aria-current={isActive ? "page" : undefined}
            >
              {item.label}
            </a>
          </li>
        );
      })
    }
    <li>
      <ThemeToggle client:load />
    </li>
  </ul>
</nav>
