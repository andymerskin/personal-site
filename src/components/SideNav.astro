---
export interface Props {
  orientation?: "horizontal" | "vertical";
  class?: string;
}

const { orientation = "vertical", class: className } = Astro.props;

type LinkItem = {
  readonly href: string;
  readonly label: string;
  readonly external?: boolean;
};

type IconItem = {
  readonly href: string;
  readonly icon: string;
  readonly label: string;
  readonly external?: boolean;
};

const items = [
  { href: "/hello", label: "Hello!" },
  { href: "/work", label: "Work" },
  { href: "/colleagues", label: "Colleagues" },
  { href: "/blog", label: "Blog" },
  { href: "/thoughts", label: "Thoughts" },
] as const satisfies LinkItem[];

const externalItems = [
  {
    href: "https://github.com/andymerskin",
    icon: "ri-github-fill",
    label: "GitHub",
    external: true,
  },
  {
    href: "https://codepen.io/andymerskin",
    icon: "ri-codepen-fill",
    label: "CodePen",
    external: true,
  },
  {
    href: "https://www.linkedin.com/in/andymerskin/",
    icon: "ri-linkedin-fill",
    label: "LinkedIn",
    external: true,
  },
] as const satisfies IconItem[];

const normalizePathname = (pathname: string) => {
  if (pathname === "/") return "/";
  return pathname.endsWith("/") ? pathname.slice(0, -1) : pathname;
};

const current = normalizePathname(Astro.url.pathname);
---

<nav
  aria-label="Primary"
  class:list={[className, "flex flex-wrap justify-between space-y-6 lg:block"]}
>
  <ul
    class:list={[
      "gap-x-6 gap-y-3",
      orientation === "horizontal"
        ? "flex flex-wrap items-center"
        : "flex flex-col",
    ]}
  >
    {
      items.map((item) => {
        const itemPath =
          "external" in item && item.external
            ? item.href
            : normalizePathname(item.href);
        const isActive =
          "external" in item && item.external
            ? current.startsWith(itemPath)
            : itemPath === current ||
              (itemPath !== "/" && current.startsWith(`${itemPath}/`));

        return (
          <li>
            <a
              href={itemPath}
              class:list={[
                "inline-flex items-center py-1 hover:opacity-100",
                isActive
                  ? "font-bold underline decoration-amber-500 decoration-2 underline-offset-4"
                  : "font-medium opacity-66",
              ]}
              aria-current={isActive ? "page" : undefined}
            >
              {item.label}
            </a>
          </li>
        );
      })
    }
  </ul>
  <hr class="hidden border-neutral-300 lg:block dark:border-neutral-700" />
  <ul class="flex items-center gap-x-3">
    {
      externalItems.map((item) => {
        return (
          <li>
            <a
              href={item.href}
              class="inline-flex items-center py-1 opacity-66 hover:opacity-100"
              aria-label={item.label}
            >
              <i class:list={[item.icon, "text-2xl"]} />
            </a>
          </li>
        );
      })
    }
  </ul>
  <footer class="hidden lg:block">
    <p class="text-sm text-neutral-600 dark:text-neutral-400">
      &copy; {new Date().getFullYear()} Andy Merskin
    </p>
    <p class="mt-2 text-sm text-neutral-500 dark:text-neutral-600">
      Astro + Vue + Tailwind
    </p>
    <p class="text-sm text-neutral-500 dark:text-neutral-600">
      Hosted on Netlify ⚡️
    </p>
  </footer>
</nav>
