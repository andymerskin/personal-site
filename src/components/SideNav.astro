---
import {
  EXTERNAL_NAV_ITEMS,
  getNavLinkAttributes,
  isActiveNavItem,
  NAV_ITEMS,
  normalizePathname,
} from "../config/navigation";

export interface Props {
  orientation?: "horizontal" | "vertical";
  class?: string;
}

const { orientation = "vertical", class: className } = Astro.props;

const current = normalizePathname(Astro.url.pathname);
---

<nav
  aria-label="Primary"
  class:list={[className, "space-y-6 md:space-y-2 lg:block"]}
>
  <ul
    class:list={[
      "gap-x-6 gap-y-2",
      orientation === "horizontal"
        ? "flex flex-wrap items-center"
        : "flex flex-col",
    ]}
  >
    {
      NAV_ITEMS.map((item) => {
        const itemPath = normalizePathname(item.href);
        const isActive = isActiveNavItem(current, item);
        const linkAttributes = getNavLinkAttributes(item);
        return (
          <li>
            <a
              href={itemPath}
              {...linkAttributes}
              class:list={[
                "inline-flex items-center py-1 hover:opacity-100",
                isActive
                  ? "font-bold underline decoration-amber-500 decoration-2 underline-offset-4"
                  : "font-medium opacity-66",
              ]}
              aria-current={isActive ? "page" : undefined}
            >
              {item.label}
            </a>
          </li>
        );
      })
    }
  </ul>
  <hr
    class="my-4 hidden w-40 border-neutral-300 lg:block dark:border-neutral-700"
  />
  <ul class="flex items-center gap-x-3">
    {
      EXTERNAL_NAV_ITEMS.map((item) => {
        return (
          <li>
            <a
              href={item.href}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center py-1 opacity-66 hover:opacity-100"
              aria-label={item.label}
            >
              <i class:list={[item.icon, "text-2xl"]} />
            </a>
          </li>
        );
      })
    }
  </ul>
  <footer class="hidden lg:block">
    <p class="text-sm text-neutral-600 dark:text-neutral-400">
      &copy; {new Date().getFullYear()} Andy Merskin
    </p>
    <p class="mt-2 text-sm text-neutral-500 dark:text-neutral-600">
      Astro + Vue + Tailwind
    </p>
    <p class="text-sm text-neutral-500 dark:text-neutral-600">
      Hosted on Netlify ⚡️
    </p>
  </footer>
</nav>
