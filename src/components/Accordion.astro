---
export interface Props {
  heading: string;
}

const { heading } = Astro.props;
---

<style>
  details summary::-webkit-details-marker {
    display: none;
  }
</style>

<details
  class="group
  not-prose
  rounded-lg
  border
  border-neutral-200
  bg-white
  shadow-sm
  dark:border-neutral-700
  dark:bg-neutral-900"
>
  <summary
    class="flex
    cursor-pointer
    list-none
    items-center
    justify-between
    rounded-t-lg
    px-6
    py-2
    hover:bg-neutral-50
    dark:hover:bg-neutral-800"
  >
    <h3
      class="text-lg
      font-bold
      text-neutral-900
      dark:text-neutral-100"
    >
      {heading}
    </h3>
    <div class="flex items-center">
      <i
        class="ri-arrow-down-s-line
        text-3xl
        text-neutral-500
        group-open:hidden
        dark:text-neutral-400"
      ></i>
      <i
        class="ri-arrow-up-s-line
        hidden
        text-3xl
        text-neutral-500
        group-open:block
        dark:text-neutral-400"
      ></i>
    </div>
  </summary>
  <div class="px-6 py-6">
    <slot />
  </div>
</details>
