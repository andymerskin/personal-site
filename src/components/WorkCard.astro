---
import type { CollectionEntry } from "astro:content";

const { entry } = Astro.props as { entry: CollectionEntry<"work"> };
---

<li>
  <a
    href={`/work/${entry.id}/`}
    class="group block focus:outline-none"
    aria-label={entry.data.title}
  >
    <div
      class:list={[
        "aspect-3/2 w-full rounded-lg overflow-hidden",
        "bg-shade-primary/2 dark:bg-white",
        "inset-ring-1 inset-ring-shade-primary/5 dark:inset-ring-0",
        "group-hover:ring-2 group-hover:ring-offset-2 group-hover:ring-neutral-800 group-hover:inset-ring-2 group-hover:inset-ring-shade-primary/10 dark:group-hover:ring-2 dark:group-hover:inset-ring-2 dark:group-hover:inset-ring-neutral-800",
        entry.data.classes,
      ]}
    >
      <div class="flex h-full w-full items-center justify-center p-6">
        <img
          src={entry.data.logo.src}
          alt=""
          class="max-h-[60%] max-w-[85%] object-contain"
          loading="lazy"
          decoding="async"
        />
      </div>
    </div>

    <div class="mt-3">
      <div class="text-lg font-bold leading-tight text-center">
        <span
          class="group-hover:underline group-hover:underline-offset-4 decoration-amber-500/80"
        >
          {entry.data.title}
        </span>
      </div>
      <div
        class="mt-1 text-sm text-center text-neutral-600 dark:text-neutral-400"
      >
        {entry.data.type}
      </div>
      <div class="text-xs text-center text-neutral-600 dark:text-neutral-400">
        {entry.data.year}
      </div>
    </div>
  </a>
</li>
