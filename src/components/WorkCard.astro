---
import type { CollectionEntry } from "astro:content";

const { entry } = Astro.props as { entry: CollectionEntry<"work"> };
---

<li>
  <a
    href={`/work/${entry.id}/`}
    class="group block focus:outline-none"
    aria-label={entry.data.title}
  >
    <div
      class:list={[
        "w-full",
        "aspect-3/2",
        "overflow-hidden",
        "rounded-lg",
        "bg-shade-primary/2",
        "inset-ring-shade-primary/5 group-hover:inset-ring-shade-primary/10 inset-ring-1 group-hover:inset-ring-2",
        "group-focus:inset-ring-shade-primary/10 group-focus:inset-ring-2",
        "group-hover:ring-2 group-hover:ring-neutral-800 group-hover:ring-offset-2",
        "group-focus:ring-2 group-focus:ring-neutral-800 group-focus:ring-offset-2",
        "dark:bg-white",
        "dark:inset-ring-0 dark:group-hover:inset-ring-2 dark:group-hover:inset-ring-neutral-800",
        "dark:group-hover:ring-2",
        entry.data.classes,
      ]}
    >
      <div class="flex h-full w-full items-center justify-center p-6">
        <img
          src={entry.data.logo.src}
          alt=""
          class="max-h-[80%] max-w-[85%] object-contain"
          loading="lazy"
          decoding="async"
        />
      </div>
    </div>

    <div class="mt-3">
      <div class="text-center text-lg leading-tight font-bold">
        <span
          class="decoration-amber-500
          decoration-2
          group-hover:underline
          group-hover:underline-offset-4
          group-focus:underline
          group-focus:underline-offset-4"
        >
          {entry.data.title}
        </span>
      </div>
      <div
        class="mt-1 text-center text-sm text-neutral-600 dark:text-neutral-400"
      >
        {entry.data.type}
      </div>
      <div class="text-center text-xs text-neutral-600 dark:text-neutral-400">
        {entry.data.year}
      </div>
    </div>
  </a>
</li>
